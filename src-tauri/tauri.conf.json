{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Signal",
  "version": "0.1.0",
  "identifier": "com.yyy.signal",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Signal",
        "width": 1200,
        "height": 800,
        "minWidth": 1024,
        "minHeight": 640
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "News",
    "shortDescription": "多社区热门文章聚合阅读器",
    "longDescription": "聚合 Hacker News、V2EX、掘金、知乎热门内容，统一信息流展示，支持离线阅读。",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
